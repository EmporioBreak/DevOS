#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
RUNTIME="$ROOT/.devos/runtime"
RUNTIME_CLI="$RUNTIME/dist/src/cli.js"
SELF_CLI="$ROOT/dist/src/cli.js"
DEVOS_REPO="EmporioBreak/DevOS"

if ! command -v node >/dev/null 2>&1; then
  echo "DevOS requires Node.js 22 or newer." >&2
  exit 1
fi

if ! command -v gh >/dev/null 2>&1; then
  echo "DevOS requires the GitHub CLI (gh) authenticated for this project's repository." >&2
  exit 1
fi

is_self_host_checkout() {
  [ "$(git -C "$ROOT" rev-parse --show-toplevel 2>/dev/null || true)" = "$ROOT" ] || return 1
  ORIGIN=$(git -C "$ROOT" remote get-url origin 2>/dev/null || true)
  case "$ORIGIN" in
    https://github.com/EmporioBreak/DevOS|https://github.com/EmporioBreak/DevOS.git|git@github.com:EmporioBreak/DevOS|git@github.com:EmporioBreak/DevOS.git)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

SELF_HOST_UPDATED=0

sync_self_host_checkout() {
  BRANCH=$(git -C "$ROOT" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
  if [ "$BRANCH" != "main" ]; then
    if [ -z "$BRANCH" ]; then
      echo "DevOS self-hosting requires an attached main branch; checkout is detached." >&2
    else
      echo "DevOS self-hosting requires main; current branch is $BRANCH." >&2
    fi
    exit 1
  fi

  if [ -n "$(git -C "$ROOT" status --porcelain)" ]; then
    echo "DevOS self-hosting will not update a dirty checkout. Commit or stash local changes first." >&2
    exit 1
  fi

  UPSTREAM=$(git -C "$ROOT" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)
  if [ "$UPSTREAM" != "origin/main" ]; then
    echo "DevOS self-hosting requires main to track origin/main; current upstream is ${UPSTREAM:-none}." >&2
    exit 1
  fi

  git -C "$ROOT" fetch origin main >/dev/null
  LOCAL_HEAD=$(git -C "$ROOT" rev-parse HEAD)
  REMOTE_HEAD=$(git -C "$ROOT" rev-parse origin/main)
  [ "$LOCAL_HEAD" = "$REMOTE_HEAD" ] && return 0

  if git -C "$ROOT" merge-base --is-ancestor HEAD origin/main; then
    echo "Updating DevOS self-host checkout to origin/main..."
    git -C "$ROOT" merge --ff-only origin/main >/dev/null
    SELF_HOST_UPDATED=1
    return 0
  fi

  if git -C "$ROOT" merge-base --is-ancestor origin/main HEAD; then
    echo "DevOS self-hosting will not move main because the local checkout is ahead of origin/main." >&2
  else
    echo "DevOS self-hosting will not move main because it has diverged from origin/main." >&2
  fi
  exit 1
}

build_self_host() {
  if ! command -v npm >/dev/null 2>&1; then
    echo "DevOS self-hosting requires npm." >&2
    exit 1
  fi

  if [ "$SELF_HOST_UPDATED" = "1" ] || [ ! -d "$ROOT/node_modules" ]; then
    echo "Installing DevOS dependencies for self-hosting..."
    (cd "$ROOT" && npm install --no-package-lock >/dev/null)
  fi

  (cd "$ROOT" && npm run build >/dev/null)
}

install_runtime() {
  if ! command -v npm >/dev/null 2>&1; then
    echo "DevOS runtime setup requires npm." >&2
    exit 1
  fi

  mkdir -p "$ROOT/.devos"
  TMP="$ROOT/.devos/runtime.tmp.$$"
  rm -rf "$TMP"
  trap 'rm -rf "$TMP"' EXIT HUP INT TERM

  echo "Refreshing DevOS runtime for this project..."
  gh repo clone "$DEVOS_REPO" "$TMP" -- --depth 1 >/dev/null
  (
    cd "$TMP"
    npm install --no-package-lock >/dev/null
    npm run build >/dev/null
  )
  rm -rf "$RUNTIME"
  mv "$TMP" "$RUNTIME"
  trap - EXIT HUP INT TERM
}

if is_self_host_checkout; then
  sync_self_host_checkout
  build_self_host
  cd "$ROOT"
  exec node "$SELF_CLI" "$@"
fi

REMOTE_HEAD=$(gh api "repos/$DEVOS_REPO/commits/main" --jq .sha)
LOCAL_HEAD=""
if [ -f "$RUNTIME_CLI" ]; then
  LOCAL_HEAD=$(git -C "$RUNTIME" rev-parse HEAD 2>/dev/null || true)
fi

if [ ! -f "$RUNTIME_CLI" ] || [ -z "$LOCAL_HEAD" ] || [ "$LOCAL_HEAD" != "$REMOTE_HEAD" ]; then
  install_runtime
fi

cd "$ROOT"
exec node "$RUNTIME_CLI" "$@"
